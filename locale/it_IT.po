#: modules/critter/voice_phrases.lua:567
msgid "A cold case."
msgstr "Un caso irrisolto."

#: features/library/sui_group_actions.lua:149
msgid "A connected collection adds and removes books as they change in the folder. A fixed collection keeps only the books found now."
msgstr "Una collezione connessa aggiunge e rimuove i libri man mano che cambiano nella cartella. Una collezione fissa mantiene solo i libri attualmente presenti."

#: modules/critter/dialog.lua:236
msgid "A cosy one."
msgstr "Tranquilla."

#: modules/critter/dialog.lua:242
msgid "A cosy one. Mostly naps."
