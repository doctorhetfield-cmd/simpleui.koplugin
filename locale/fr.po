#: modules/critter/reaction_lines.lua:159
msgid "A MARATHON! You're unstoppable!"
msgstr "UN MARATHON ! Tu es inarrêtable !"

#: modules/critter/dialog.lua:523
msgid "A bit behind."
msgstr "Un peu en retard."

#: modules/critter/reaction_lines.lua:75
msgid "A book finished. I need to lie down."
msgstr "J'ai fini un livre. Il faut que j'aille m'allonger."

#: modules/critter/reaction_lines.lua:90
msgid "A book is over. Good for you."
msgstr "Tu as fini un livre. Bravo !"

#: modules/critter/voice_phrases.lua:119
msgid "A book keeps me company."
msgstr "Un livre me tient compagnie."

#: modules/critter/voice_lines.lua:214
msgid "A brief read. Elegant."
msgstr "Une lecture rapide. Élégant."

#: modules/critter/reaction_lines.lua:124
msgid "A brief, brilliant visit to another world!"
msgstr "Une visite brève et éblouissante d'un autre monde !"

#: modules/critter/dialog.lua:340 modules/critter/voice_phrases.lua:101
msgid "A chapter helps."
msgstr "Un chapitre, ça aide."

#: modules/critter/phrases.lua:102
msgid "A chapter pairs well with a coffee."
msgstr "Un chapitre associé avec une bon café."

#: modules/critter/reaction_lines.lua:188
msgid "A charger would be lovely."
msgstr "Un chargeur, ce serait génial."

#: modules/critter/dialog.lua:225
msgid "A cosy one."
msgstr "Un endroit bien douillet."

#: modules/critter/dialog.lua:231
msgid "A cosy one. Mostly naps."
msgstr "Un endroit bien douillet. Surtout des siestes."

#: modules/critter/reaction_lines.lua:254
msgid "A day for books, at last."
msgstr "Enfin une journée consacrée aux livres."

#: modules/critter/reaction_lines.lua:144
msgid "A decent session. I almost stayed awake."
msgstr "Une séance plutôt pas mal. J'ai failli rester éveillé."

#: modules/critter/voice_lines.lua:79
msgid "A deep dive. I felt at home."
msgstr "Une immersion totale. Je m'y suis senti comme chez moi."

#: modules/critter/voice_lines.lua:211
msgid "A few pages, neatly stitched."
msgstr "Quelques pages, soigneusement reliées."

#: screens/sui_onboarding.lua:188
msgid "A folder named \"Books\" will be created and set as the library home."
msgstr "Un dossier nommé « Livres » sera créé et défini comme répertoire par défaut de la bibliothèque."

#: screens/sui_stats_windows.lua:2201
msgid "A freeze can only bridge a single missed day right after an active one — yesterday doesn't qualify."
msgstr "Un gel ne peut combler qu'un seul jour manqué juste après un jour actif — hier ne compte pas."

#: modules/critter/phrases.lua:94
msgid "A fresh day, a fresh page."
msgstr "Un nouveau jour, une nouvelle page."

#: modules/critter/reaction_lines.lua:287
msgid "A fresh month, a fresh stack."
msgstr "A fresh month, a fresh stack."

