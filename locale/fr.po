msgid "A long session. Elementary."
msgstr "Une longue séance. C'est élémentaire."

#: modules/critter/dialog.lua:221
msgid "A map! A sword! A tiny backpack!"
msgstr "Une carte ! Une épée ! Un tout petit sac à dos !"

