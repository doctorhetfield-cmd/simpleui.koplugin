#: modules/critter/phrases.lua:214
msgid "Just a few pages left."
msgstr "就剩几页了。"

#: modules/critter/reaction_lines.lua:120
msgid "Just a little one today."
msgstr "今天就只是翻了一小会儿。"

#: modules/critter/voice_lines.lua:101
msgid "Just a seam. Nothing serious."
msgstr "只是道缝。不严重。"

#: modules/critter/voice_phrases.lua:647
msgid "Just the corners?"
msgstr "就啃啃书角？"

