#: modules/critter/reaction_lines.lua:159
msgid "A MARATHON! You're unstoppable!"
msgstr "马拉松啊！根本停不下来！"

#: modules/critter/dialog.lua:534
msgid "A bit behind."
msgstr "有点落后了。"

#: modules/critter/reaction_lines.lua:75
msgid "A book finished. I need to lie down."
msgstr "一本书读完了，我得躺一会儿。"

#: modules/critter/reaction_lines.lua:90
msgid "A book is over. Good for you."
msgstr "一本书结束了，算你厉害。"

#: modules/critter/voice_phrases.lua:425
msgid "A book keeps me company."
msgstr "有本书陪着我。"

#: modules/critter/voice_lines.lua:214
msgid "A brief read. Elegant."
msgstr "读了一小会儿。优雅。"

#: modules/critter/reaction_lines.lua:124
msgid "A brief, brilliant visit to another world!"
msgstr "一次短暂而精彩的异世界之旅！"

#: modules/critter/voice_phrases.lua:539
msgid "A busy week, I deduce."
msgstr "据我推断，这周忙。"

#: modules/critter/dialog.lua:351 modules/critter/voice_phrases.lua:343
msgid "A chapter helps."
msgstr "读一章就有了。"

#: modules/critter/phrases.lua:104
msgid "A chapter pairs well with a coffee."
msgstr "一章配一杯咖啡，正好。"

#: modules/critter/reaction_lines.lua:188
msgid "A charger would be lovely."
msgstr "有个充电器就好了。"

#: modules/critter/voice_phrases.lua:567
msgid "A cold case."
msgstr "一桩冷案。"

#: modules/critter/dialog.lua:236
msgid "A cosy one."
msgstr "惬意的那种。"

#: modules/critter/dialog.lua:242
msgid "A cosy one. Mostly naps."
msgstr "惬意的那种，多半在打瞌睡。"

#: modules/critter/reaction_lines.lua:254
msgid "A day for books, at last."
msgstr "终于到了属于书的日子。"

#: modules/critter/reaction_lines.lua:144
msgid "A decent session. I almost stayed awake."
msgstr "还不错的一段时间，我差点没睡着。"

#: modules/critter/voice_lines.lua:79
msgid "A deep dive. I felt at home."
msgstr "一次深潜。我像回到了家。"

#: modules/critter/game_lines.lua:34
msgid "A draw! We think alike."
msgstr "平局！咱俩想到一块儿了。"

#: modules/critter/game_lines.lua:32
msgid "A draw."
msgstr "平局。"

#: modules/critter/game_lines.lua:33
msgid "A draw. Boring."
msgstr "平局。没劲。"

#: modules/critter/voice_lines.lua:211
msgid "A few pages, neatly stitched."
msgstr "几页，缝得整整齐齐。"

#: screens/sui_onboarding.lua:188
msgid "A folder named \"Books\" will be created and set as the library home."
msgstr "将创建一个名为“Books”的文件夹，并将其设置为书库主目录。"

#: screens/sui_stats_windows.lua:2243
msgid ""
"A freeze can only bridge a single missed day right after an active one — "
"yesterday doesn't qualify."
msgstr "冻结补签仅可衔接一次紧接有效阅读日之后的缺勤 — 昨天不符合条件。"

#: modules/critter/phrases.lua:96
msgid "A fresh day, a fresh page."
msgstr "新的一天，新的一页。"

#: modules/critter/reaction_lines.lua:287
msgid "A fresh month, a fresh stack."
msgstr "新月，新书堆。"

#: modules/critter/dialog.lua:716
msgid "A friendly eye."
