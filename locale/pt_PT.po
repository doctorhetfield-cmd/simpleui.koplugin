#: modules/critter/voice_phrases.lua:563
msgid "I won't tell. Probably."
msgstr "Não conto. Provavelmente."

#: modules/critter/voice_lines.lua:173
msgid "I'd give it a pat."
msgstr "Eu dava-lhe uma festinha."

#: modules/critter/dialog.lua:110
msgid "I'd hate to keep them waiting."
msgstr "Não as quero deixar à espera."

#: modules/critter/voice_phrases.lua:186
msgid "I'd know. I'm a Grand Champion."
