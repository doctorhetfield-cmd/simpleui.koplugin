#: modules/module_heatmap.lua:311
msgid "How many weeks of history to include, and (in Calendar view) how many weeks the grid shows — this count is unaffected by Scale, which only resizes the cells. In Time of day view, this only changes how much history feeds the shading — the grid itself always has one column per hour."
msgstr "Kolik týdnů historie zahrnout a (v zobrazení Kalendář) kolik týdnů se zobrazí v mřížce — tento počet neovlivňuje Měřítko, které pouze mění velikost buněk. V zobrazení Denní doba tato hodnota jen mění, kolik historie ovlivňuje stínování — mřížka má vždy jeden sloupec na hodinu."

#: modules/critter/dialog.lua:342
msgid "How was your day?"
msgstr "Jak se po dnešku cítíš?"

#: modules/critter/dialog.lua:341
msgid "How's the afternoon going?"
msgstr "Jak se ti dnes daří?"

#: features/sui_accent_picker.lua:84
msgid "Hue"
msgstr "Odstín"

#: modules/critter/voice_phrases.lua:483
msgid "I admire it."
msgstr "Obdivuji to."

#: modules/critter/voice_phrases.lua:443
msgid "I approve of habits."
msgstr "Mám rád pravidelné návyky."

#: modules/critter/voice_phrases.lua:670
msgid "I brought you your book!"
msgstr "Přinesl jsem ti knihu!"

#: modules/critter/dialog.lua:150
msgid "I can hear the pages."
msgstr "Slyším šustění stránek."

#: modules/critter/voice_phrases.lua:624
msgid "I can't count. I'm proud!"
msgstr "Neumím počítat. Ale mám radost!"

#: modules/critter/dialog.lua:538
msgid "I checked the rules."
msgstr "Zkontroloval jsem pravidla."

#: modules/critter/voice_lines.lua:83
msgid "I counted every wave."
msgstr "Spočítal jsem každou vlnu."

#: modules/critter/reaction_lines.lua:195
msgid "I didn't want to say anything."
msgstr "Nechtěl jsem nic říkat."

#: modules/critter/voice_phrases.lua:251
msgid "I dreamt of my sunken city again."
msgstr "Zase se mi zdálo o mém potopeném městě."

#: modules/critter/reaction_lines.lua:336
msgid "I dusted the shelves twice."
msgstr "Dvakrát jsem oprášil police."

#: modules/critter/voice_lines.lua:77
msgid "I felt a ripple of joy."
msgstr "Pocítil jsem vlnku radosti."

#: modules/critter/dialog.lua:541
msgid "I forgot I had one."
msgstr "Na ten cíl jsem úplně zapomněl."

#: modules/critter/dialog.lua:188
msgid "I found something between the pages."
msgstr "Hele, něco je mezi stránkami!"

#: modules/critter/dialog.lua:353
msgid "I had a feeling it would be."
msgstr "Něco mi říkalo, že to tak bude."

#: modules/critter/dialog.lua:250
msgid "I have a suspect."
msgstr "Mám podezřelého."

#: modules/critter/voice_phrases.lua:225
msgid "I have people for that."
msgstr "Na to mám lidi."

#: modules/critter/voice_phrases.lua:181
msgid "I inspired it."
msgstr "To je samozřejmě moje zásluha."

#: modules/critter/reaction_lines.lua:314
msgid "I kept your place."
msgstr "Hlídal jsem ti místo."

#: modules/critter/dialog.lua:524
msgid "I knew it. I've seen the shelf."
msgstr "To mi bylo jasné. Stačí se podívat do tvé knihovny."

#: modules/critter/dialog.lua:308
msgid "I knew it. The good kind of reader."
msgstr "Já to věděla. Čtenář, jak má být."

#: modules/critter/dialog.lua:720
msgid "I knew you'd say yes."
msgstr "Věděl jsem, že řekneš ano."

#: modules/critter/voice_lines.lua:59
msgid "I looked fabulous watching."
msgstr "Při tom jsem samozřejmě vypadala úžasně."

#: modules/critter/voice_phrases.lua:663
msgid "I love all the days!"
msgstr "Mám rád všechny dny!"

#: modules/critter/dialog.lua:443
msgid "I love counting."
msgstr "Počítání miluju."

#: modules/critter/game_lines.lua:67
msgid "I love playing with you."
msgstr "S tebou mě to fakt baví."

#: modules/critter/voice_phrases.lua:463
msgid "I mean the prose."
msgstr "Myslím tu prózu."

#: modules/critter/voice_lines.lua:236
msgid "I missed you so much!"
msgstr "Tolik se mi po tobě stýskalo!"

#: modules/critter/phrases.lua:324
msgid "I missed you, %s!"
msgstr "Chyběl jsi mi, %s!"

#: modules/critter/dialog.lua:502
msgid "I nap all the time."
msgstr "Já podřimuju pořád."

#: modules/critter/voice_lines.lua:188
#: modules/critter/voice_lines.lua:239
msgid "I nearly cast a search spell."
msgstr "Málem jsem seslala pátrací kouzlo."

#: modules/critter/reaction_lines.lua:357
#: modules/critter/reaction_lines.lua:414
msgid "I never doubted you. Much."
msgstr "Nikdy jsem o tobě nepochyboval. Skoro."

#: modules/critter/voice_lines.lua:218
msgid "I observe everything."
msgstr "Pozoruji úplně všechno."

#: modules/critter/voice_phrases.lua:655
msgid "I once waited twenty years."
msgstr "Jednou jsem čekal dvacet let."

#: modules/critter/dialog.lua:127
msgid "I only have small ones."
msgstr "Já mám jen malé otázky."

#: modules/critter/voice_phrases.lua:147
msgid "I pushed your bookmark off the shelf."
msgstr "Shodila jsem ti záložku z police."

#: modules/critter/voice_phrases.lua:312
msgid "I quite like it."
msgstr "Docela se mi to líbí."

#: modules/critter/voice_phrases.lua:407
msgid "I read Paradise Lost once."
msgstr "Kdysi jsem četl Ztracený ráj."

#: modules/critter/voice_phrases.lua:558
msgid "I read the last page first."
msgstr "Nejdřív čtu poslední stránku."

#: modules/critter/reaction_lines.lua:275
msgid "I remember the day we met."
msgstr "Pamatuji si den, kdy jsme se poznali."

#: modules/critter/voice_phrases.lua:122
msgid "I sat on every one, though."
msgstr "Ale na každé jsem seděla."

#: modules/critter/voice_phrases.lua:606
msgid "I saved you a spot."
msgstr "Schoval jsem ti místo."

#: modules/critter/dialog.lua:293
msgid "I speak from experience."
msgstr "Mám s tím své zkušenosti."

#: modules/critter/voice_phrases.lua:321
msgid "I speak many unspeakable tongues."
msgstr "Ovládám spoustu nevyslovitelných jazyků."

#: modules/critter/voice_lines.lua:125
msgid "I stared at the moon. Alone."
msgstr "Zíral jsem na Měsíc. Sám."

#: modules/critter/reaction_lines.lua:349
msgid "I started talking to the bookcase."
msgstr "Začal jsem si povídat s knihovnou."

#: modules/critter/voice_phrases.lua:108
msgid "I supervised from the sill."
msgstr "Dohlížela jsem z parapetu."

#: modules/critter/voice_lines.lua:71
msgid "I supervised. Very hard."
msgstr "Měla jsem nad tím dohled. Velmi náročná práce."

#: modules/critter/dialog.lua:159
msgid "I visit them at night."
msgstr "V noci je chodím navštěvovat."

#: modules/critter/voice_phrases.lua:632
msgid "I wagged the whole time."
msgstr "Celou dobu jsem vrtěl ocasem."

#: modules/critter/voice_phrases.lua:304
msgid "I waited aeons. It's fine."
msgstr "Čekal jsem celé věky. To nic."

#: modules/critter/voice_lines.lua:164
msgid "I waited. Good dog."
msgstr "Čekal jsem. Hodný pes."

#: modules/critter/game_lines.lua:88
msgid "I want to frame that one."
msgstr "Tohle bych si chtěl zarámovat."

#: modules/critter/voice_lines.lua:230
msgid "I was busy. Being fabulous."
msgstr "Měla jsem práci. Být úžasná není jen tak."

#: modules/critter/voice_lines.lua:41
msgid "I wasn't waiting. Much."
msgstr "Nečekala jsem. Tedy… ne moc."

#: modules/critter/voice_lines.lua:167
msgid "I watched the door all week."
msgstr "Celý týden jsem sledoval dveře."

#: modules/critter/game_lines.lua:29
msgid "I win! Want to try again?"
msgstr "Vítězství je moje! Dáme odvetu?"

#: modules/critter/game_lines.lua:27
msgid "I win."
msgstr "Vítězství je moje."

#: modules/critter/game_lines.lua:28
msgid "I win. Obviously."
msgstr "Vítězství je samozřejmě moje."

#: modules/critter/dialog.lua:329
msgid "I won't tell anyone."
msgstr "Nikomu to neřeknu."

#: modules/critter/voice_phrases.lua:563
msgid "I won't tell. Probably."
msgstr "Neprozradím to. Asi."

#: modules/critter/voice_lines.lua:173
msgid "I'd give it a pat."
msgstr "To bych pohladil."

#: modules/critter/dialog.lua:110
msgid "I'd hate to keep them waiting."
msgstr "Nechci je nechat čekat."

#: modules/critter/voice_phrases.lua:186
msgid "I'd know. I'm a Grand Champion."
msgstr "To poznám. Jsem přece velká šampionka."

#: modules/critter/dialog.lua:376
msgid "I'd rather not talk."
msgstr "Radši o tom nechci mluvit."

#: modules/critter/voice_lines.lua:35
msgid "I'll allow a purr."
msgstr "Předení povoluji."

#: modules/critter/voice_lines.lua:203
msgid "I'll allow a short nap."
msgstr "Krátké zdřímnutí povoluji."

#: modules/critter/dialog.lua:491
msgid "I'll be back soon."
msgstr "Brzy se vrátím."

#: modules/critter/voice_phrases.lua:497
msgid "I'll be borrowing it."
msgstr "To si půjčím."

#: modules/critter/voice_phrases.lua:421
msgid "I'll be in the shade. Reading."
msgstr "Budu ve stínu. A číst."

#: modules/critter/voice_phrases.lua:221
msgid "I'll do the speech."
msgstr "Proslov přednesu já."

#: modules/critter/voice_lines.lua:134
msgid "I'll flash a fang for you."
msgstr "Pro tebe vycením tesák."

#: modules/critter/dialog.lua:202
msgid "I'll give it back. Warm."
msgstr "Vrátím ti ji. Ještě je teplá."

#: modules/critter/voice_phrases.lua:659
msgid "I'll hold it for you."
msgstr "Podržím ti to."

#: modules/critter/reaction_lines.lua:202
msgid "I'll just rest my eyes."
msgstr "Jen si na chvíli odpočinu očima."

#: modules/critter/game_lines.lua:73
msgid "I'll keep that one on the shelf."
msgstr "Tohle nechám na polici."

#: modules/critter/dialog.lua:494
msgid "I'll keep your place."
msgstr "Podržím ti místo."

#: modules/critter/dialog.lua:408
msgid "I'll look."
msgstr "Podívám se."

#: modules/critter/dialog.lua:627
msgid "I'll pretend I didn't need it."
msgstr "Budu předstírat, že to nepotřebuju."

#: modules/critter/dialog.lua:600
msgid "I'll remind you."
msgstr "Připomenu ti to."

#: modules/critter/voice_phrases.lua:550
msgid "I'll say nothing. Mostly."
msgstr "Nic neřeknu. Většinou."

#: modules/critter/voice_phrases.lua:475
msgid "I'll skip those pages."
msgstr "Tyhle stránky přeskočím."

#: modules/critter/voice_lines.lua:197
msgid "I'll stir in a little luck."
msgstr "Přimíchám trochu štěstí."

#: modules/critter/game_lines.lua:75
msgid "I'll think about that all night."
msgstr "To mi bude vrtat hlavou celou noc."

#: modules/critter/voice_phrases.lua:457
msgid "I'm almost warm."
msgstr "Už mi skoro není zima."

#: modules/critter/reaction_lines.lua:177
msgid "I'm at %d%%."
msgstr "Jsem na %d%%."

#: modules/critter/game_lines.lua:98
msgid "I'm flipping. Call it."
msgstr "Házím mincí. Vyber si."

#: modules/critter/dialog.lua:495
msgid "I'm good at that."
msgstr "To mi jde."

#: modules/critter/voice_phrases.lua:719
msgid "I'm good at this."
msgstr "To mi jde."

#: modules/critter/reaction_lines.lua:431
msgid "I'm keeping count, you know."
msgstr "Víš, že si to počítám."

#: modules/critter/reaction_lines.lua:66
#: modules/critter/reaction_lines.lua:88
msgid "I'm not crying. It's dust."
msgstr "Já nebrečím. To je jen prach."

#: modules/critter/voice_phrases.lua:471
msgid "I'm on my fourth century."
msgstr "Jsem ve svém čtvrtém století."

#: modules/critter/dialog.lua:398
msgid "I'm out of stars. Imagine one."
msgstr "Došly mi hvězdy. Nějakou si představ."

#: modules/critter/voice_phrases.lua:600
msgid "I'm ready!"
msgstr "Jsem připravený!"

#: modules/critter/voice_phrases.lua:361
msgid "I'm six different people."
msgstr "Jsem šest různých osobností."

#: modules/critter/dialog.lua:415
msgid "I'm the one who counts."
msgstr "To já počítám."

#: modules/critter/voice_phrases.lua:365
msgid "I'm very good at it."
msgstr "V tom jsem opravdu dobrý."

#: modules/critter/voice_lines.lua:161
msgid "I'm wagging so hard!"
msgstr "Vrtím ocasem jako divý!"

#: modules/critter/voice_phrases.lua:163
msgid "I'm watching."
msgstr "Sleduji tě."

#: modules/critter/voice_phrases.lua:696
msgid "I've been practising."
msgstr "Procvičovala jsem kouzla."

#: modules/critter/voice_phrases.lua:130
msgid "I've been sleeping on it."
msgstr "Spím na ní. Má ideální velikost."

#: modules/critter/voice_phrases.lua:145
msgid "I've been staring at you for an hour."
msgstr "Už hodinu na tebe zírám."

#: modules/critter/voice_phrases.lua:571
msgid "I've been studying it."
msgstr "Zkoumal jsem to."

#: modules/critter/reaction_lines.lua:255
msgid "I've been waiting all year."
msgstr "Čekal jsem celý rok."

#: modules/critter/voice_phrases.lua:400
msgid "I've had a few."
msgstr "Pár jsem jich měl."

#: modules/critter/voice_phrases.lua:77
msgid "I've ignored you since noon."
msgstr "Od poledne si tě nevšímám."

#: modules/critter/voice_phrases.lua:494
msgid "I've never seen myself read."
msgstr "Nikdy jsem se neviděl číst."

#: modules/critter/dialog.lua:171
msgid "I've noticed. Not a speck of dust."
msgstr "To je vidět. Ani smítko prachu."

#: modules/critter/voice_phrases.lua:479
msgid "I've practised for centuries."
msgstr "Cvičil jsem celá staletí."

