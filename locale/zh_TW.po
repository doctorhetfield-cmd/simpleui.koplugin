#: modules/critter/dialog.lua:117
msgid "Is it about books?"
msgstr "是關於書的嗎？"

#: modules/critter/voice_phrases.lua:749
msgid "It came back. They always do."
msgstr "它又回來了。向來如此。"

#: modules/critter/dialog.lua:544
msgid "It didn't forget you."
msgstr "它沒有忘記你。"

#: modules/critter/voice_phrases.lua:408
msgid "It explained a lot."
msgstr "它解釋了很多事。"

#: modules/critter/voice_phrases.lua:252
msgid "It had a lovely library."
msgstr "它有一座很棒的圖書館。"

#: modules/critter/dialog.lua:498
msgid "It needed a rest."
msgstr "它需要休息。"

#: modules/critter/voice_phrases.lua:608
msgid "It only smells a little."
msgstr "只是有點味道。"

#: modules/critter/game_lines.lua:58
msgid "It was %s."
msgstr "是 %s。"

#: modules/critter/voice_phrases.lua:333
msgid "It wasn't always mine."
msgstr "它以前不是我的。"

#: modules/critter/reaction_lines.lua:99
msgid "It will be sung about."
msgstr "它會被寫成歌傳唱。"

#: modules/critter/dialog.lua:390
msgid "It's %s. Any reading planned?"
msgstr "%s 了。有讀書計畫嗎？"

#: modules/critter/reaction_lines.lua:299
msgid "It's %s. I barely noticed."
msgstr "都 %s 了。我都沒怎麼注意。"

#: modules/critter/dialog.lua:388
msgid "It's %s. Reading day, surely?"
msgstr "%s 了。讀書天，對吧？"

#: modules/critter/phrases.lua:287
msgid "It's Friday!"
msgstr "週五啦！"

#: modules/critter/reaction_lines.lua:247
msgid "It's World Book Day!"
msgstr "今天是世界讀書日！"

#: modules/critter/voice_phrases.lua:671
msgid "It's a bit wet. Sorry."
msgstr "有點溼。對不起。"

#: modules/critter/voice_phrases.lua:602
msgid "It's a bookmark now."
msgstr "現在它是書籤了。"

#: modules/critter/voice_phrases.lua:146
msgid "It's a compliment. Probably."
msgstr "算誇你吧。大概。"

#: modules/critter/reaction_lines.lua:350
msgid "It's a good listener."
msgstr "它很會傾聽。"

#: modules/critter/phrases.lua:224
msgid "It's been %d days."
msgstr "已經 %d 天了。"

#: modules/critter/reaction_lines.lua:335
msgid "It's been a while."
msgstr "好久不見了。"

#: modules/critter/reaction_lines.lua:363
msgid "It's been so long."
msgstr "太久了。"

#: modules/critter/voice_phrases.lua:682
msgid "It's called reading."
msgstr "這叫讀書。"

#: modules/critter/voice_phrases.lua:264
msgid "It's me. I'm stretching."
msgstr "是我。我在舒展身體。"

#: modules/critter/voice_phrases.lua:684
msgid "It's much quieter now."
msgstr "現在安靜多了。"

#: modules/critter/dialog.lua:620
msgid "It's quiet on the shelf. Pat me?"
msgstr "書架上好安靜。摸摸我？"

#: modules/critter/voice_phrases.lua:72
msgid "It's warm now. You're welcome."
msgstr "現在暖了。不客氣。"

#: features/sui_style.lua:2530
msgid "Italic"
msgstr "斜體"

#: infra/sui_config.lua:1209 infra/sui_config.lua:2244
#: modules/module_coverdeck.lua:1627 modules/module_coverdeck.lua:1639
#: modules/module_currently.lua:1348 modules/module_currently.lua:1360
#: modules/reading_stats/module_reading_stats.lua:1643 screens/sui_menu.lua:814
